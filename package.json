{
  "name": "brainfood-web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:full": "node scripts/dev-api.mjs & vite",
    "build": "vite build && node scripts/prerender.mjs",
    "build:spa": "vite build",
    "prerender": "node scripts/prerender.mjs",
    "deploy": "vercel build && vercel deploy --prebuilt",
    "deploy:prod": "vercel build --prod && vercel deploy --prebuilt --prod",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && npm run seed",
    "seed": "node scripts/seed-content.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "lint": "echo 'lint placeholder'"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@supabase/supabase-js": "^2.110.2",
    "clsx": "^2.1.0",
    "gsap": "^3.12.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.576.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^7.1.0",
    "three": "^0.183.2",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "sirv": "^3.0.2",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
