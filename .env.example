# ═══════════════════════════════════════════════════════════════════════════
# Copy to .env.local and fill in. See README-ADMIN.md for where to find these.
# ═══════════════════════════════════════════════════════════════════════════

# ── Public (shipped in the browser bundle — this is fine and by design) ──────
# The anon key grants nothing on its own; Row Level Security in Postgres decides
# what any caller can read or write.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only (NEVER prefix these with NEXT_PUBLIC_ — that would ship them publicly) ──
# The service-role key bypasses Row Level Security entirely. It is used only by
# the functions in /api, which run on Vercel's servers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Mailgun (server-only — powers the public contact forms) ──
# Prefer the scoped sending key; MAILGUN_API_KEY is the fallback.
MAILGUN_SENDING_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="Brain Food Recovery Services <noreply@example.com>"
# Set to "eu" only if your Mailgun account is in the EU region.
MAILGUN_REGION=
# Where form submissions are delivered.
CONTACT_RECIPIENT=brainfoodrs@gmail.com

# ── reCAPTCHA (scores public form submissions) ──
# The site key and project ID are PUBLIC and are compiled in as defaults in
# src/config/recaptcha.js — set these only to override them.
#   NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LfXlYItAAAAAAno7LBGFpHeA6Wr23PgGpc1I65H
#   RECAPTCHA_PROJECT_ID=brainfood-505317
#
# Verification needs a credential for ONE of Google's two backends. Set either
# one; with neither, verification is skipped entirely and the forms fall back to
# the honeypot and the per-IP rate limit.
#
# CLASSIC (what this site uses) — the 40-character "6Lf…" SECRET key shown next
# to the site key in the reCAPTCHA admin console. Verified at
# https://www.google.com/recaptcha/api/siteverify
RECAPTCHA_SECRET_KEY=
#
# ENTERPRISE (alternative) — a Google Cloud API key ("AIza…") from
# Console → APIs & Services → Credentials, RESTRICTED to the reCAPTCHA
# Enterprise API. Not a secret key; Enterprise has no such thing. Takes
# precedence over RECAPTCHA_SECRET_KEY when both are set.
RECAPTCHA_API_KEY=
#
# Minimum risk score to accept, 0.0 (certainly a bot) to 1.0 (certainly human).
# Defaults to 0.5. Tune from real traffic in the reCAPTCHA console.
RECAPTCHA_MIN_SCORE=0.5

# ── Facebook (server-only — feeds the "On Facebook" section on the homepage) ──
# The page ID is public (it is the page's own URL) and is compiled in as a
# default in src/config/facebook.js; set it only to point at a different page.
#   FACEBOOK_PAGE_ID=100206719692613
#
# The token is the secret. It must be a PAGE access token — not a user token —
# carrying `pages_read_engagement`, minted in the Graph API Explorer against the
# app that owns the page and then exchanged for a long-lived one.
#
# Long-lived page tokens never expire, but the DATA ACCESS behind them lapses 90
# days after the token was issued, at which point the Graph calls start failing
# and the homepage section quietly removes itself. Re-mint before that lands.
# `GET /debug_token` reports the deadline as `data_access_expires_at`.
#
# With this unset the section does not render at all — see isFacebookConfigured().
FACEBOOK_PAGE_ACCESS_TOKEN=
