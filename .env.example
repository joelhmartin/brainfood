# ═══════════════════════════════════════════════════════════════════════════
# Copy to .env.local and fill in. See README-ADMIN.md for where to find these.
# ═══════════════════════════════════════════════════════════════════════════

# ── Public (shipped in the browser bundle — this is fine and by design) ──────
# The anon key grants nothing on its own; Row Level Security in Postgres decides
# what any caller can read or write.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only (NEVER prefix these with VITE_ — that would ship them publicly) ──
# The service-role key bypasses Row Level Security entirely. It is used only by
# the functions in /api, which run on Vercel's servers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel deploy hook, fired when content is published so the static pages get
# rebuilt. Optional: without it, published content still appears on the live site
# (the app fetches at runtime); only the prerendered HTML lags until next deploy.
# Create at: Vercel → Project → Settings → Git → Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=
