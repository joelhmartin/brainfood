# ═══════════════════════════════════════════════════════════════════════════
# Copy to .env.local and fill in. See README-ADMIN.md for where to find these.
# ═══════════════════════════════════════════════════════════════════════════

# ── Public (shipped in the browser bundle — this is fine and by design) ──────
# The anon key grants nothing on its own; Row Level Security in Postgres decides
# what any caller can read or write.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only (NEVER prefix these with NEXT_PUBLIC_ — that would ship them publicly) ──
# The service-role key bypasses Row Level Security entirely. It is used only by
# the functions in /api, which run on Vercel's servers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
